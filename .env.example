# The external URL for the separately developed AI assistant.
# Example: https://assistant.akshatkadam.com
NEXT_PUBLIC_AGENT_URL=

# Public base URL of the separately deployed Port-Assistant service.
# Local development: http://localhost:3001
NEXT_PUBLIC_ASSISTANT_API_URL=http://localhost:3001

# Server-only assistant configuration. Do not prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=
MODEL=gemini-3.5-flash
